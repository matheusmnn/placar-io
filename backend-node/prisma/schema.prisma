generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Formato {
  PONTOS_CORRIDOS
  MATA_MATA
}

enum StatusCampeonato {
  NAO_INICIADO
  EM_ANDAMENTO
  ENCERRADO
}

enum StatusPartida {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
}

enum Posicao {
  GOLEIRO
  ZAGUEIRO
  LATERAL
  VOLANTE
  MEIA
  ATACANTE
}

enum TipoCartao {
  AMARELO
  VERMELHO
}

model Usuario {
  id          Int          @id @default(autoincrement())
  nome        String
  email       String       @unique
  senhaHash   String
  createdAt   DateTime     @default(now())
  campeonatos Campeonato[]
}

model Campeonato {
  id            Int              @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario          @relation(fields: [usuarioId], references: [id])
  nome          String
  formato       Formato          @default(PONTOS_CORRIDOS)
  status        StatusCampeonato @default(NAO_INICIADO)
  pontosVitoria Int              @default(3)
  pontosEmpate  Int              @default(1)
  idaVolta      Boolean          @default(false)
  dataInicio    DateTime?
  dataFim       DateTime?
  descricao     String?
  logoUrl       String?
  createdAt     DateTime         @default(now())
  times         Time[]
  partidas      Partida[]
}

model Time {
  id           Int        @id @default(autoincrement())
  campeonatoId Int
  campeonato   Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  nome         String
  cidade       String?
  escudoUrl    String?
  jogadores    Jogador[]
  mandanteEm   Partida[]  @relation("Mandante")
  visitanteEm  Partida[]  @relation("Visitante")
  gols         Gol[]
  cartoes      Cartao[]
}

model Jogador {
  id      Int      @id @default(autoincrement())
  timeId  Int
  time    Time     @relation(fields: [timeId], references: [id], onDelete: Cascade)
  numero  Int?
  nome    String
  posicao Posicao?
  gols    Gol[]
  cartoes Cartao[]
}

model Partida {
  id              Int           @id @default(autoincrement())
  campeonatoId    Int
  campeonato      Campeonato    @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  mandanteId      Int?
  mandante        Time?         @relation("Mandante", fields: [mandanteId], references: [id])
  visitanteId     Int?
  visitante       Time?         @relation("Visitante", fields: [visitanteId], references: [id])
  golsMandante    Int?
  golsVisitante   Int?
  rodada          Int
  fase            String?
  ordemFase       Int?
  status          StatusPartida @default(AGENDADA)
  dataPartida     DateTime?
  local           String?
  gols            Gol[]
  cartoes         Cartao[]

  @@index([campeonatoId])
}

model Gol {
  id        Int      @id @default(autoincrement())
  partidaId Int
  partida   Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  timeId    Int
  time      Time     @relation(fields: [timeId], references: [id])
  jogadorId Int?
  jogador   Jogador? @relation(fields: [jogadorId], references: [id])
  minuto    Int?

  @@index([partidaId])
}

model Cartao {
  id        Int        @id @default(autoincrement())
  partidaId Int
  partida   Partida    @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  timeId    Int
  time      Time       @relation(fields: [timeId], references: [id])
  jogadorId Int?
  jogador   Jogador?   @relation(fields: [jogadorId], references: [id])
  tipo      TipoCartao
  minuto    Int?

  @@index([partidaId])
}
