DATABASE_URL="postgresql://placar:placar@localhost:5432/placar?schema=public"

# Troque obrigatoriamente em produção — valor placeholder é rejeitado no start.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="troque-isto-em-producao-base64"
JWT_EXPIRES_IN="7d"

PORT=8080

# Separe várias origens por vírgula. Em produção é obrigatório.
CORS_ORIGIN="http://localhost:5173"

# "production" ativa validação estrita das variáveis acima e o trust proxy.
NODE_ENV="development"
